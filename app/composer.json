{
    "name": "docker-template/app",
    "type": "project",
    "require": {
        "ezyang/htmlpurifier": "^4.18",
        "robmorgan/phinx": "^0.16.10",
        "stripe/stripe-php": "^16.0",
        "dompdf/dompdf": "^3.1",
        "chillerlan/php-qrcode": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
